# Copy to .env locally. Production refuses to start without a password.
SALES_MAP_PASSWORD=
PORT=3000
DATA_DIR=./data
# Optional for global address lookup. Never expose this in frontend variables.
OPENCAGE_API_KEY=
# Set to 1 only behind a trusted reverse proxy (Render / similar).
TRUST_PROXY=0

# Azure Maps street tiles + address lookup (server-side only):
MAPS_API_KEY=
# Optional managed PostgreSQL connection. Use TLS verification in production.
# Leave unset for local SQLite; never place a production URL in source control.
DATABASE_URL=
